<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <Script file="AutoMail.lua"/>

    <Button name="AutoMailTab" parent="MailFrame" inherits="FriendsFrameTabTemplate" id="3" text="Auto Mail">
        <Anchors>
            <Anchor point="LEFT" relativeTo="MailFrameTab2" relativePoint="RIGHT" x="-16" y="0"/>
        </Anchors>
        <Scripts>
            <OnLoad>
                PanelTemplates_SetNumTabs(MailFrame, 3)
            </OnLoad>
            <OnClick>
                MailFrameTab_OnClick(self, 3)
            </OnClick>
        </Scripts>
    </Button>

    <Frame name="AutoMailFrame" hidden="true" parent="MailFrame" mixin="AutoMailFrameMixin">
        <Anchors>
            <Anchor point="TOPLEFT" relativeTo="MailFrameInset" x="4" y="-4"/>
            <Anchor point="BOTTOMRIGHT" relativeTo="MailFrameInset" x="-4" y="4"/>
        </Anchors>
        <Scripts>
            <OnLoad method="OnLoad"/>
            <OnEvent method="OnEvent"/>
            <OnShow>
                self:UpdateItemList(true)
            </OnShow>
        </Scripts>
        <Layers>
            <Layer level="ARTWORK">
                <FontString parentKey="RecipientText" inherits="GameFontNormalLarge" justifyH="LEFT">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="15" y="-15"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <ScrollFrame parentKey="ScrollFrame" inherits="UIPanelScrollFrameTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.RecipientText" relativePoint="BOTTOMLEFT" x="0" y="-10"/>
                    <Anchor point="BOTTOMRIGHT" x="-30" y="60"/>
                </Anchors>
                <ScrollChild>
                    <Frame parentKey="Content" inherits="VerticalLayoutFrame">
                        <Size x="280" y="1"/>
                        <KeyValues>
                            <KeyValue key="spacing" value="2" type="number"/>
                        </KeyValues>
                    </Frame>
                </ScrollChild>
            </ScrollFrame>

            <Button parentKey="SendButton" inherits="UIPanelButtonTemplate" text="Send All Items">
                <Size x="160" y="30"/>
                <Anchors>
                    <Anchor point="BOTTOM" x="0" y="15"/>
                </Anchors>
                <Scripts>
                    <OnClick>
                        self:GetParent():SendNextBatch()
                    </OnClick>
                </Scripts>
            </Button>
        </Frames>
    </Frame>

    <Button name="AutoMailEntryTemplate" virtual="true">
        <Size x="260" y="22"/>
        <Layers>
            <Layer level="ARTWORK">
                <Texture parentKey="Icon">
                    <Size x="18" y="18"/>
                    <Anchors>
                        <Anchor point="LEFT" x="5" y="0"/>
                    </Anchors>
                </Texture>
                <Texture parentKey="QualityOverlay" hidden="true">
                    <Size x="18" y="18"/>
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeKey="$parent.Icon" x="-2" y="2"/>
                    </Anchors>
                </Texture>
                <Texture parentKey="IconBorder" file="Interface\Common\WhiteIconFrame" hidden="true">
                    <Size x="20" y="20"/>
                    <Anchors>
                        <Anchor point="CENTER" relativeKey="$parent.Icon"/>
                    </Anchors>
                </Texture>
                <FontString parentKey="Quantity" inherits="NumberFontNormal" justifyH="RIGHT">
                    <Anchors>
                        <Anchor point="BOTTOMRIGHT" relativeKey="$parent.Icon" x="1" y="0"/>
                    </Anchors>
                </FontString>
                <FontString parentKey="Text" inherits="GameFontNormalSmallLeft" justifyH="LEFT" maxLines="1">
                    <Anchors>
                        <Anchor point="LEFT" relativeKey="$parent.Icon" relativePoint="RIGHT" x="8" y="0"/>
                        <Anchor point="RIGHT" x="-5" y="0"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <HighlightTexture file="Interface\Buttons\UI-Listbox-Highlight" alphaMode="ADD"/>
    </Button>
</Ui>